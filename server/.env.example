# HTTP port. Defaults to 3000, which collides with `next dev`'s default port when running the
# client and server together locally (Phase 9) -- set this to 3001 and point the client's
# NEXT_PUBLIC_API_URL (client/.env.example) at it.
PORT=3001

# Comma-separated list of origins allowed by CORS (main.ts's app.enableCors). Empty by default,
# which blocks every browser origin -- the client (Phase 9) calls this API directly from the
# browser for everything except auth, so its dev origin must be allow-listed locally.
CORS_ORIGINS=http://localhost:3000

# Connection string used by drizzle-kit and migration scripts (POSTGRES_USER, owner role).
DATABASE_URL=postgresql://postgres_owner:change-me@localhost:5432/attack_surface_studio

# Connection string the running application uses (APP_DB_USER, least-privilege role).
APP_DATABASE_URL=postgresql://app_role:change-me-too@localhost:5432/attack_surface_studio

# JWT access-token signing secret (generate a random value per environment, min 32 chars,
# SEC-001/SEC-017). Refresh tokens are opaque CSPRNG values, not JWTs, so they need no secret.
JWT_ACCESS_SECRET=change-me-generate-a-random-32-plus-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Redis connection backing the BullMQ tool-run job queue (Phase 6, ADR-003). Shared by the API
# process (enqueues runs) and the separate worker process (executes them).
REDIS_URL=redis://localhost:6379

# Local filesystem root for content-addressable blob storage (Phase 8, ADR-014) -- raw tool
# output and evidence file bytes. Must live outside any web-served directory.
STORAGE_ROOT=./data/blobs

# Global request-rate limit (ThrottlerGuard). Defaults shown; raise only for environments
# (e.g. heavy-polling integration test suites) that legitimately need a higher ceiling.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# AI Assistant (Phase 11, ADR-015) -- optional. NVIDIA NIM exposes an OpenAI-compatible
# chat-completions endpoint; leave NVIDIA_API_KEY empty to run with the assistant disabled
# (endpoints respond 503 instead of silently faking an answer). Never commit a real key here.
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=meta/llama-3.3-70b-instruct
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
