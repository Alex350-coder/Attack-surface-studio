# PostgreSQL superuser/owner (used locally for docker-compose bootstrap and migrations)
POSTGRES_DB=attack_surface_studio
POSTGRES_USER=postgres_owner
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Least-privilege application role, provisioned by db/init/01-app-role.sh
# The application (server/) connects with these credentials at runtime, never with POSTGRES_USER.
APP_DB_USER=app_role
APP_DB_PASSWORD=change-me-too
